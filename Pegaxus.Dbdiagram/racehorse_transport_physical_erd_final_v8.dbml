}


//////////////////////////////////////////////////////////////
// FLOW 1 - ACCOUNT / BOOKING / TRANSPORT CORE
//////////////////////////////////////////////////////////////

Table Account {
  account_id bigint [pk, increment]

  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]

  account_type account_type [not null]
  status account_status [not null, default: 'ACTIVE']

  last_login_at timestamp

  email_verified_at timestamp // Null or Verified

  avatar_url varchar(500) //ảnh đại diện
  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    status
    account_type
  }
}



Table RefreshToken {
  Note: 'RefreshToken: Token dùng để cấp lại Access Token cho một Account. Một Account có thể có nhiều RefreshToken cho nhiều thiết bị/phiên đăng nhập. Database chỉ lưu token_hash, không lưu raw token.'

  refresh_token_id bigint [pk, increment]

  account_id bigint [not null]

  token_hash varchar(255) [not null, unique]

  expires_at timestamp [not null]

  created_at timestamp [not null]

  revoked_at timestamp

  // Token mới thay thế token hiện tại khi sử dụng refresh-token rotation
  replaced_by_token_id bigint

  created_by_ip varchar(64)
  revoked_by_ip varchar(64)

  device_info varchar(500)

  indexes {
    account_id
    expires_at
    revoked_at
  }
}


Table Customer {
  customer_id bigint [pk, increment]

  account_id bigint [not null, unique]

  full_name varchar(150) [not null]
  phone varchar(30)
  date_of_birth date

  address varchar(500)
  country varchar(100)

  identity_number varchar(100)

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    phone
  }
}


Table Employee {
  employee_id bigint [pk, increment]

  account_id bigint [not null, unique]

  employee_code varchar(50) [not null, unique]
  full_name varchar(150) [not null]
  phone varchar(30)

  role employee_role [not null]

  is_active boolean [not null, default: true]

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    role
    is_active
  }
}


Table Horse {
  horse_id bigint [pk, increment]

  customer_id bigint [not null]

  horse_name varchar(150) [not null]

  passport_number varchar(100) [unique]
  microchip_number varchar(100) [unique]

  breed varchar(100)
  sex horse_sex

  date_of_birth date
  color varchar(100)

  country_of_origin varchar(100)

  // Current physical measurements. Historical measurements can be added
  // to HorseHealthLog later if the business needs trend tracking.
  weight_kg decimal(6,2)
  height_cm decimal(5,2)

  identification_notes text

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    customer_id
    horse_name
  }
}


Table Booking {
  booking_id bigint [pk, increment]

  booking_code varchar(50) [not null, unique]

  customer_id bigint [not null]

  assigned_employee_id bigint

  status booking_status [not null, default: 'PENDING']

  origin_address varchar(500) [not null]
  origin_country varchar(100) [not null]

  destination_address varchar(500) [not null]
  destination_country varchar(100) [not null]

  requested_departure_date date [not null]
  requested_arrival_date date

  special_requirements text
  customer_note text

  submitted_at timestamp
  approved_at timestamp
  rejected_at timestamp
  cancelled_at timestamp

  rejection_reason text
  cancellation_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    customer_id
    assigned_employee_id
    status
    requested_departure_date
  }
}


Table BookingHorse {
  booking_id bigint [not null]
  horse_id bigint [not null]

  special_handling_notes text

  created_at timestamp [not null]

  indexes {
    (booking_id, horse_id) [pk]
    horse_id
  }
}


Table BookingStatusHistory {
  Note: 'BookingStatusHistory: Lịch sử thay đổi trạng thái Booking. type cho biết hành động nghiệp vụ nào đã gây ra thay đổi status.'

  booking_status_history_id bigint [pk, increment]

  booking_id bigint [not null]

  type booking_history_type [not null]

  previous_status booking_status
  new_status booking_status [not null]

  changed_by_account_id bigint [not null]

  reason text

  changed_at timestamp [not null]

  indexes {
    booking_id
    type
    changed_by_account_id
    changed_at
  }
}


Table Transport {
  transport_id bigint [pk, increment]

  transport_code varchar(50) [not null, unique]

  booking_id bigint [not null, unique]

  status transport_status [not null, default: 'CREATED']

  actual_departure_at timestamp
  actual_arrival_at timestamp

  completed_at timestamp
  cancelled_at timestamp

  cancellation_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    status
  }
}


//////////////////////////////////////////////////////////////
// FLOW 2 - TRANSPORT / ROUTE PLANNING
//////////////////////////////////////////////////////////////

Table TransportPlan {
  transport_plan_id bigint [pk, increment]

  transport_id bigint [not null]

  plan_code varchar(50) [not null, unique]

  status transport_plan_status [not null, default: 'DRAFT']

  planned_start_at timestamp
  planned_end_at timestamp

  planning_note text

  estimated_duration_minutes int
  estimated_distance_km decimal(10,2)

  approved_by_employee_id bigint
  approved_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    transport_id
    status
    approved_by_employee_id
  }
}


Table RoutePlan {
  Note: 'RoutePlan: Kế hoạch tuyến đường của một TransportPlan. Đây là tập hợp các Route được sắp xếp nối tiếp từ điểm đầu đến điểm cuối.'

  route_plan_id bigint [pk, increment]

  // Một TransportPlan có thể có nhiều RoutePlan (PRIMARY/BACKUP/RETURN).
  // Không đặt UNIQUE trên transport_plan_id; ràng buộc loại route và số lượng route active do business rule kiểm soát.
  transport_plan_id bigint [not null]

  route_plan_code varchar(50) [not null, unique]

  status route_plan_status [not null, default: 'DRAFT']

  total_distance_km decimal(10,2)
  estimated_duration_minutes int

  route_note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    status
  }
}


Table Location {
  Note: 'Location: Địa điểm master trên bản đồ. Một địa điểm chỉ tạo một lần và có thể được nhiều Route tái sử dụng, ví dụ Thành phố Hồ Chí Minh.'

  location_id bigint [pk, increment]

  location_name varchar(200) [not null]

  location_type location_type

  address varchar(500)

  city varchar(100)
  state_province varchar(100)
  country varchar(100) [not null]

  latitude decimal(10,7)
  longitude decimal(10,7)

  location_note text

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    location_name
    location_type
    country
  }
}


Table Route {
  Note: 'Route: Một tuyến đường có hướng nối từ một Location bắt đầu đến một Location kết thúc. Route có thể được tái sử dụng trong nhiều RoutePlan.'

  route_id bigint [pk, increment]

  route_code varchar(50) [not null, unique]

  from_location_id bigint [not null]
  to_location_id bigint [not null]

  route_name varchar(200)

  transport_mode transport_mode [not null]

  distance_km decimal(10,2)
  estimated_duration_minutes int

  route_note text

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    from_location_id
    to_location_id
    transport_mode
  }
}


Table RoutePlanRoute {
  Note: 'RoutePlanRoute: Bảng trung gian biểu diễn một Route được dùng trong một RoutePlan, gồm thứ tự đi, Driver/Escort phụ trách, provider thuê ngoài và thời gian dự kiến/thực tế của chính lần sử dụng Route đó.'

  route_plan_route_id bigint [pk, increment]

  route_plan_id bigint [not null]
  route_id bigint [not null]

  sequence_no int [not null]

  route_type route_type [not null, default: 'PRIMARY']

  // Nullable khi plan còn DRAFT; phải có trước khi RoutePlan CONFIRMED/ACTIVE.
  // Business rule: Employee được gán phải có role = DRIVER.
  driver_employee_id bigint

  // Nullable; bắt buộc với chặng nội bộ khi RoutePlan được phân công đầy đủ.
  // Business rule: Employee được gán phải có role = ESCORT.
  escort_employee_id bigint

  // Nullable; có giá trị khi chặng được thuê ngoài.
  // Khi có provider thì chặng không được gán vehicle/driver/escort nội bộ.
  transport_provider_id bigint

  planned_departure_at timestamp
  planned_arrival_at timestamp

  actual_departure_at timestamp
  actual_arrival_at timestamp

  note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    route_plan_id
    route_id
    route_type
    driver_employee_id
    escort_employee_id
    transport_provider_id

    (route_plan_id, sequence_no) [unique]
  }
}


Table Vehicle {
  Note: 'Vehicle: Phương tiện vận chuyển master dùng chung cho ROAD, AIR hoặc SEA, ví dụ xe tải chở ngựa, máy bay hoặc tàu. Vehicle không thuộc cố định một TransportPlan; phương tiện được gán vào từng chặng RoutePlanRoute.'

  vehicle_id bigint [pk, increment]

  vehicle_code varchar(50) [not null, unique]

  vehicle_name varchar(200)

  transport_mode transport_mode [not null]

  // Có thể null đối với AIR/SEA nếu không dùng biển số theo cách của xe đường bộ
  license_plate varchar(50) [unique]

  vehicle_type varchar(100)

  manufacturer varchar(100)
  model varchar(100)

  capacity_horses int

  status vehicle_status [not null, default: 'AVAILABLE']

  registration_number varchar(100)
  registration_expiry_date date

  insurance_number varchar(100)
  insurance_expiry_date date

  special_equipment text

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    transport_mode
    status
  }
}


Table RoutePlanRouteVehicle {
  Note: 'RoutePlanRouteVehicle: Bảng trung gian N-N gán Vehicle vào một chặng RoutePlanRoute cụ thể. Nhờ vậy một Transport có thể đi xe -> máy bay -> xe, và cùng một Vehicle có thể được tái sử dụng ở nhiều chuyến/chặng khác nhau.'

  route_plan_route_id bigint [not null]
  vehicle_id bigint [not null]

  assigned_at timestamp [not null]

  note text

  indexes {
    (route_plan_route_id, vehicle_id) [pk]
    vehicle_id
  }
}


Table TransportProvider {
  transport_provider_id bigint [pk, increment]

  provider_code varchar(50) [not null, unique]

  provider_name varchar(200) [not null]

  status provider_status [not null, default: 'ACTIVE']

  contact_name varchar(150)
  phone varchar(30)
  email varchar(255)

  address varchar(500)
  country varchar(100)

  tax_code varchar(100)

  supported_modes varchar(100)

  note text

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    provider_name
    status
  }
}


Table TransportPlanProvider {
  transport_plan_id bigint [not null]
  transport_provider_id bigint [not null]

  service_type varchar(100)

  assigned_at timestamp [not null]

  note text

  indexes {
    (transport_plan_id, transport_provider_id) [pk]
    transport_provider_id
  }
}


Table EmployeeTransportPlan {
  employee_id bigint [not null]
  transport_plan_id bigint [not null]

  responsibility varchar(150)

  assigned_at timestamp [not null]

  is_primary boolean [not null, default: false]

  note text

  indexes {
    (employee_id, transport_plan_id) [pk]
    transport_plan_id
  }
}


//////////////////////////////////////////////////////////////
// FLOW 3 - EXECUTION / HANDOVER / HORSE HEALTH
//////////////////////////////////////////////////////////////

Table HandoverRecord {
  Note: 'HandoverRecord: Một lần bàn giao trong Transport. from_type/to_type xác định bên giao/nhận là CUSTOMER hay EMPLOYEE; from/to_route_plan_route_id xác định chặng vừa kết thúc và chặng tiếp theo.'

  handover_record_id bigint [pk, increment]

  transport_id bigint [not null]

  handover_code varchar(50) [not null, unique]

  sequence_no int [not null]

  handover_type handover_type [not null]
  status handover_status [not null, default: 'PLANNED']

  planned_handover_at timestamp
  actual_handover_at timestamp

  // Structured handover parties.
  from_type handover_party_type [not null]
  to_type handover_party_type [not null]

  from_customer_id bigint
  from_employee_id bigint

  to_customer_id bigint
  to_employee_id bigint

  // RoutePlanRoute is used instead of Route because sequence_no belongs
  // to the concrete route usage within a RoutePlan.
  // Pickup: from_route_plan_route_id = null, to = first leg.
  // Internal handover: both present.
  // Delivery: from = final leg, to_route_plan_route_id = null.
  from_route_plan_route_id bigint
  to_route_plan_route_id bigint

  // Optional snapshot/contact text retained for operational evidence.
  from_party_name varchar(200)
  from_contact_name varchar(150)
  from_contact_phone varchar(30)

  to_party_name varchar(200)
  to_contact_name varchar(150)
  to_contact_phone varchar(30)

  location_name varchar(200)
  address varchar(500)
  country varchar(100)

  horse_condition_note text

  document_handover_note text
  equipment_handover_note text
  discrepancy_note text

  sender_signature_url varchar(500)
  receiver_signature_url varchar(500)

  completed_at timestamp
  cancelled_at timestamp
  cancellation_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    transport_id
    status
    from_type
    to_type
    from_customer_id
    from_employee_id
    to_customer_id
    to_employee_id
    from_route_plan_route_id
    to_route_plan_route_id
    actual_handover_at

    (transport_id, sequence_no) [unique]
  }
}


Table HorseHealthLog {
  horse_health_log_id bigint [pk, increment]

  transport_id bigint [not null]
  horse_id bigint [not null]
  employee_id bigint [not null]

  log_type horse_health_log_type [not null]

  health_status horse_health_status [not null]

  checked_at timestamp [not null]

  temperature_celsius decimal(4,1)
  heart_rate_bpm int
  respiratory_rate_bpm int

  hydration_status hydration_status

  behavior_note text
  symptom_note text
  injury_note text
  feeding_note text
  hydration_note text

  treatment_provided text
  medication_given text

  veterinarian_required boolean [not null, default: false]
  veterinarian_note text

  location_description varchar(500)

  photo_url varchar(500)

  general_note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    transport_id
    horse_id
    employee_id
    health_status
    checked_at

    (transport_id, horse_id)
  }
}


//////////////////////////////////////////////////////////////
// FLOW 4 - INCIDENT / EMERGENCY
//////////////////////////////////////////////////////////////

Table IncidentReport {
  Note: 'IncidentReport: Báo cáo sự cố phát sinh trong quá trình vận chuyển. category gồm VEHICLE, HORSE_HEALTH hoặc BOTH.'

  incident_report_id bigint [pk, increment]

  incident_code varchar(50) [not null, unique]

  employee_id bigint [not null]
  location_id bigint [not null]

  category incident_category [not null]
  severity incident_severity [not null]

  status incident_status [not null, default: 'REPORTED']

  title varchar(200) [not null]

  description text [not null]

  occurred_at timestamp [not null]
  reported_at timestamp [not null]

  immediate_action text

  resolution_summary text

  resolved_at timestamp

  cancelled_at timestamp
  cancellation_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    employee_id
    location_id
    category
    severity
    status
    occurred_at
  }
}


Table VehicleIncidentDetail {
  vehicle_incident_detail_id bigint [pk, increment]

  incident_report_id bigint [not null, unique]

  vehicle_id bigint [not null]

  incident_type vehicle_incident_type [not null]

  vehicle_condition text

  damage_description text

  vehicle_operable boolean [not null, default: true]

  repair_required boolean [not null, default: false]
  towing_required boolean [not null, default: false]
  replacement_vehicle_required boolean [not null, default: false]

  estimated_repair_cost decimal(18,2)

  repair_note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    vehicle_id
    incident_type
  }
}


Table HorseHealthIncidentDetail {
  horse_health_incident_detail_id bigint [pk, increment]

  incident_report_id bigint [not null]

  horse_id bigint [not null]

  incident_type horse_incident_type [not null]

  condition_description text [not null]

  symptoms text

  body_temperature_celsius decimal(4,1)

  heart_rate_bpm int
  respiratory_rate_bpm int

  first_aid_provided text

  veterinarian_required boolean [not null, default: false]

  veterinarian_contacted_at timestamp

  veterinarian_instruction text

  medication_given text

  horse_transportable boolean

  outcome_note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    incident_report_id
    horse_id
    incident_type

    (incident_report_id, horse_id)
  }
}


Table EmergencyCostRequest {
  emergency_cost_request_id bigint [pk, increment]

  incident_report_id bigint [not null]

  request_code varchar(50) [not null, unique]

  category emergency_cost_category [not null]

  description text [not null]

  requested_amount decimal(18,2) [not null]

  currency varchar(3) [not null]

  status emergency_cost_status [not null, default: 'PENDING']

  justification text [not null]

  requested_at timestamp [not null]

  approved_amount decimal(18,2)

  cancelled_at timestamp
  cancellation_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    incident_report_id
    category
    status
  }
}


Table CostApprovalDecision {
  cost_approval_decision_id bigint [pk, increment]

  emergency_cost_request_id bigint [not null, unique]

  employee_id bigint [not null]

  decision approval_decision [not null]

  approved_amount decimal(18,2)

  decision_reason text

  decided_at timestamp [not null]

  created_at timestamp [not null]

  indexes {
    employee_id
    decision
    decided_at
  }
}


//////////////////////////////////////////////////////////////
// FLOW 5 - FINANCE / BILLING / PAYMENT
//////////////////////////////////////////////////////////////

Table Invoice {
  invoice_id bigint [pk, increment]

  invoice_code varchar(50) [not null, unique]

  booking_id bigint [not null]
  employee_id bigint [not null]

  status invoice_status [not null, default: 'DRAFT']

  currency varchar(3) [not null]

  subtotal decimal(18,2) [not null, default: 0]
  discount_amount decimal(18,2) [not null, default: 0]
  tax_amount decimal(18,2) [not null, default: 0]
  total_amount decimal(18,2) [not null, default: 0]

  issued_at timestamp
  due_date date
  paid_at timestamp

  cancelled_at timestamp
  cancellation_reason text

  billing_note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    booking_id
    employee_id
    status
    due_date
  }
}


Table InvoiceItem {
  invoice_item_id bigint [pk, increment]

  invoice_id bigint [not null]

  horse_id bigint

  emergency_cost_request_id bigint [unique]

  item_type invoice_item_type [not null]

  description varchar(500) [not null]

  quantity decimal(10,2) [not null, default: 1]

  unit_price decimal(18,2) [not null]

  line_amount decimal(18,2) [not null]

  note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    invoice_id
    horse_id
    item_type
  }
}


Table Receipt {
  receipt_id bigint [pk, increment]

  receipt_code varchar(50) [not null, unique]

  invoice_id bigint [not null]

  amount decimal(18,2) [not null]

  currency varchar(3) [not null]

  payment_method payment_method [not null]

  status receipt_status [not null, default: 'PENDING']

  transaction_reference varchar(150)

  paid_at timestamp
  confirmed_at timestamp

  note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    invoice_id
    status
    transaction_reference
    paid_at
  }
}


Table InvoiceStatusHistory {
  Note: 'InvoiceStatusHistory: Lịch sử thay đổi trạng thái Invoice. type cho biết hành động nghiệp vụ gây ra thay đổi; changed_by_account_id có thể null nếu hệ thống tự động thực hiện, ví dụ MARK_OVERDUE.'

  invoice_status_history_id bigint [pk, increment]

  invoice_id bigint [not null]

  type invoice_history_type [not null]

  previous_status invoice_status
  new_status invoice_status [not null]

  changed_by_account_id bigint

  reason text

  changed_at timestamp [not null]

  created_at timestamp [not null]

  indexes {
    invoice_id
    type
    changed_by_account_id
    new_status
    changed_at
  }
}


Table FinancialReport {
  Note: 'FinancialReport: Báo cáo tài chính tổng hợp theo một Transport, được hệ thống sinh từ dữ liệu Invoice, InvoiceItem, Receipt và chi phí liên quan; không có trạng thái lưu nháp.'

  financial_report_id bigint [pk, increment]

  report_code varchar(50) [not null, unique]

  transport_id bigint [not null, unique]

  currency varchar(3) [not null]

  total_invoiced_amount decimal(18,2) [not null, default: 0]
  total_paid_amount decimal(18,2) [not null, default: 0]
  total_emergency_cost decimal(18,2) [not null, default: 0]
  outstanding_amount decimal(18,2) [not null, default: 0]

  summary_note text

  generated_at timestamp [not null]

  created_at timestamp [not null]
  updated_at timestamp [not null]
}


//////////////////////////////////////////////////////////////
// FLOW 6 - CLAIM / CLAIM RESOLUTION
//////////////////////////////////////////////////////////////

Table Claim {
  Note: 'Claim: Khiếu nại do Customer gửi liên quan đến một lần bàn giao. Hệ thống chỉ lưu khiếu nại và kết quả; việc trao đổi/thương lượng giữa Customer và Manager diễn ra ngoài hệ thống.'

  claim_id bigint [pk, increment]

  claim_code varchar(50) [not null, unique]

  customer_id bigint [not null]

  handover_record_id bigint [not null]

  claim_type claim_type [not null]

  status claim_status [not null, default: 'PENDING']

  title varchar(200) [not null]

  description text [not null]

  requested_compensation_amount decimal(18,2)

  currency varchar(3)

  evidence_note text
  customer_note text

  submitted_at timestamp [not null]

  reviewed_at timestamp
  resolved_at timestamp
  cancelled_at timestamp

  cancellation_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    customer_id
    handover_record_id
    claim_type
    status
    submitted_at
  }
}


Table ClaimResolution {
  Note: 'ClaimResolution: Kết quả xử lý/thỏa thuận cuối cùng của một Claim, ví dụ mức bồi thường thực tế sau khi hai bên trao đổi trực tiếp.'

  claim_resolution_id bigint [pk, increment]

  claim_id bigint [not null, unique]

  resolution_type claim_resolution_type [not null]

  resolution_summary text [not null]

  approved_compensation_amount decimal(18,2)

  currency varchar(3)

  corrective_action text

  internal_note text

  resolved_at timestamp [not null]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    resolution_type
    resolved_at
  }
}


//////////////////////////////////////////////////////////////
// FLOW 7 - COMPLIANCE / LEGAL DOSSIER
//
// THUẬT NGỮ QUAN TRỌNG:
// ComplianceRequirement = loại yêu cầu pháp lý/loại giấy tờ master.
// DossierTemplate = bộ hồ sơ mẫu.
// DossierTemplateItem = requirement được cấu hình trong bộ hồ sơ mẫu.
// ComplianceDossier = bộ hồ sơ pháp lý THỰC TẾ của một Transport.
// DossierRequirement = requirement THỰC TẾ trong bộ hồ sơ của chuyến đó.
// ComplianceDocument = giấy tờ logic Customer cung cấp để đáp ứng requirement.
// DocumentVersion = một lần/version nộp của cùng một ComplianceDocument.
// DocumentAttachment = từng file cụ thể thuộc cùng một DocumentVersion.
// DocumentReview = kết quả kiểm tra của một version.
// DocumentRequest = yêu cầu Customer cung cấp/chỉnh sửa/upload lại/bổ sung.
// AuthoritySubmission = từng lần gửi bộ hồ sơ tới cơ quan có thẩm quyền.
//
// Lưu ý baseline hiện tại:
// - DossierRequirement đang ở cấp dossier/chuyến đi.
// - Chưa mô hình hóa requirement riêng theo từng Horse.
//////////////////////////////////////////////////////////////

Table ComplianceRequirement {
  Note: 'ComplianceRequirement: Danh mục master các loại yêu cầu pháp lý hoặc loại giấy tờ mà hệ thống biết có thể cần trong hồ sơ.'

  compliance_requirement_id bigint [pk, increment]

  requirement_code varchar(50) [not null, unique]

  requirement_name varchar(200) [not null]

  description text

  country varchar(100)

  category compliance_requirement_category [not null, default: 'OTHER']

  issuing_authority varchar(200)

  bcp_code varchar(50)
  legal_basis text

  validity_required boolean [not null, default: false]
  validity_period_days int

  status compliance_requirement_status [not null, default: 'ACTIVE']

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    requirement_name
    country
    category
    status
  }
}


Table DossierTemplate {
  Note: 'DossierTemplate: Bộ hồ sơ pháp lý mẫu cho một kịch bản vận chuyển. Template xác định thông thường cần những loại yêu cầu nào.'

  dossier_template_id bigint [pk, increment]

  template_code varchar(50) [not null, unique]

  template_name varchar(200) [not null]

  description text

  version_no int [not null, default: 1]

  status dossier_template_status [not null, default: 'DRAFT']

  effective_from date
  effective_to date

  // Soft delete
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    is_deleted
    template_name
    status
  }
}


Table DossierTemplateItem {
  Note: 'DossierTemplateItem: Một dòng yêu cầu nằm trong DossierTemplate, dùng để liên kết Template với ComplianceRequirement và đánh dấu yêu cầu bắt buộc hay không.'

  dossier_template_item_id bigint [pk, increment]

  dossier_template_id bigint [not null]

  compliance_requirement_id bigint [not null]

  sequence_no int [not null]

  is_mandatory boolean [not null, default: true]
  applies_per_horse boolean [not null, default: false]

  instruction text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    dossier_template_id
    compliance_requirement_id

    (dossier_template_id, compliance_requirement_id) [unique]
    (dossier_template_id, sequence_no) [unique]
  }
}


Table ComplianceDossier {
  Note: 'ComplianceDossier: Bộ hồ sơ do Transport Specialist lập và chịu trách nhiệm hoàn thiện trước khi chuyến đi xuất phát. Kết quả kiểm dịch hoặc hải quan phát sinh tại cửa khẩu không ghi vào status của bảng này mà lưu riêng trong QuarantineProof và CustomsClearanceProof.'

  compliance_dossier_id bigint [pk, increment]

  dossier_code varchar(50) [not null, unique]

  transport_id bigint [not null, unique]

  status compliance_dossier_status [not null, default: 'DRAFT']

  opened_at timestamp [not null]

  ready_for_submission_at timestamp
  approved_at timestamp
  rejected_at timestamp
  closed_at timestamp

  rejection_reason text

  note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    status
  }
}


Table DossierRequirement {
  Note: 'DossierRequirement: Một yêu cầu pháp lý thực tế đã được sinh ra trong ComplianceDossier của chuyến đi cụ thể, dựa trên loại ComplianceRequirement.'

  dossier_requirement_id bigint [pk, increment]

  compliance_dossier_id bigint [not null]

  compliance_requirement_id bigint [not null]

  // NULL = yêu cầu chung cho toàn chuyến; NOT NULL = yêu cầu riêng cho một Horse.
  horse_id bigint

  status dossier_requirement_status [not null, default: 'PENDING']

  is_mandatory boolean [not null, default: true]

  // Soft delete is allowed only for optional requirements.
  is_deleted boolean [not null, default: false]
  deleted_at timestamp
  deleted_by_account_id bigint

  due_date date

  // Được tính khi áp dụng requirement dựa trên validity_period_days.
  valid_until date

  instruction text

  satisfied_at timestamp

  waived_reason text

  note text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    compliance_dossier_id
    compliance_requirement_id
    horse_id
    status

    (compliance_dossier_id, compliance_requirement_id, horse_id) [unique]
  }
}


Table ComplianceDocument {
  Note: 'ComplianceDocument: Giấy tờ thực tế được cung cấp để đáp ứng một DossierRequirement. Đây là document logic, không phải từng file upload.'

  compliance_document_id bigint [pk, increment]

  dossier_requirement_id bigint [not null, unique]

  document_code varchar(50) [not null, unique]

  document_name varchar(200) [not null]

  status compliance_document_status [not null, default: 'PROVIDED']

  document_number varchar(150)

  issuing_authority varchar(200)

  issued_date date
  expiry_date date

  note text

  created_by_account_id bigint [not null]
  updated_by_account_id bigint [not null]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    document_number
    status
    expiry_date
  }
}


Table DocumentVersion {
  Note: 'DocumentVersion: Một phiên bản file cụ thể của ComplianceDocument. Khi giấy tờ bị sửa hoặc upload lại thì tạo version mới, không tạo ComplianceDocument mới.'

  document_version_id bigint [pk, increment]

  compliance_document_id bigint [not null]

  version_no int [not null]

  file_name varchar(255) [not null]

  file_url varchar(1000) [not null]

  mime_type varchar(100)

  file_size_bytes bigint

  upload_note text

  uploaded_by_account_id bigint [not null]

  uploaded_at timestamp [not null]

  created_at timestamp [not null]

  indexes {
    compliance_document_id

    (compliance_document_id, version_no) [unique]
  }
}

Table DocumentAttachment {
  Note: 'DocumentAttachment: Một file cụ thể thuộc cùng một lần nộp/DocumentVersion. Nhiều file như ảnh mặt trước và mặt sau cùng trỏ tới một DocumentVersion.'

  document_attachment_id uuid [pk]

  // DocumentVersion hiện tại dùng bigint, nên FK này dùng bigint để cùng kiểu dữ liệu.
  document_version_id bigint [not null]

  file_name varchar(255) [not null]
  file_url varchar(1000) [not null]
  mime_type varchar(100)
  file_size_bytes bigint

  // Thứ tự hiển thị/xử lý file trong cùng một DocumentVersion.
  sort_order int [not null]

  created_at timestamp [not null]

  indexes {
    document_version_id [name: 'DocumentAttachment_document_version_id_idx']
    (document_version_id, sort_order) [unique, name: 'DocumentAttachment_document_version_id_sort_order_key']
  }
}



Table DocumentReview {
  Note: 'DocumentReview: Kết quả kiểm tra của một DocumentVersion cụ thể, ví dụ APPROVED, REJECTED hoặc REVISION_REQUIRED.'

  document_review_id bigint [pk, increment]

  document_version_id bigint [not null]

  result document_review_result [not null]

  review_comment text

  reviewed_by_account_id bigint [not null]

  reviewed_at timestamp [not null]

  created_at timestamp [not null]

  indexes {
    document_version_id
    result
    reviewed_at
  }
}


Table DocumentRequest {
  Note: 'DocumentRequest: Yêu cầu gửi tới Customer để cung cấp, sửa, upload lại hoặc bổ sung thông tin cho một DossierRequirement.'

  document_request_id uuid [pk]

  document_review_id uuid [unique]

  dossier_requirement_id uuid [not null]

  error_category varchar(40)

  request_code varchar(50) [not null, unique]

  request_type document_request_type [not null]

  status document_request_status [not null, default: 'OPEN']

  message text [not null]

  requested_at timestamp [not null]

  due_date date

  fulfilled_at timestamp

  cancelled_at timestamp
  cancellation_reason text

  requested_by_account_id uuid [not null]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    dossier_requirement_id
    request_type
    status
    requested_at
  }
}


Table DocumentRequestComment {
  Note: 'DocumentRequestComment: Trao đổi giữa Customer và Transport Specialist trong phạm vi một DocumentRequest.'

  document_request_comment_id uuid [pk]

  document_request_id uuid [not null]

  author_account_id uuid [not null]

  message varchar(2000) [not null]

  created_at timestamp [not null]

  indexes {
    (document_request_id, created_at)
    author_account_id
  }
}


Table MissingDocumentReminder {
  Note: 'MissingDocumentReminder: Hàng đợi durable cho email nhắc Customer bổ sung hồ sơ còn thiếu; được worker xử lý và retry.'

  missing_document_reminder_id uuid [pk]

  compliance_dossier_id uuid [not null]

  recipient_account_id uuid [not null]

  requirement_ids uuid[] [not null]

  due_date date [not null]

  note varchar(2000)

  automatic_date date

  created_at timestamp [not null]

  last_attempt_at timestamp
  email_sent_at timestamp
  cancelled_at timestamp
  email_attempts int [not null, default: 0]

  indexes {
    (compliance_dossier_id, automatic_date) [unique]
    (email_sent_at, cancelled_at, last_attempt_at)
    recipient_account_id
  }
}


Table AuthoritySubmission {
  Note: 'AuthoritySubmission: Một lần thực tế gửi ComplianceDossier tới cơ quan có thẩm quyền. Một dossier có thể được gửi nhiều lần nếu bị trả về hoặc từ chối.'

  authority_submission_id bigint [pk, increment]

  compliance_dossier_id bigint [not null]

  submission_no int [not null]

  authority_name varchar(200) [not null]

  status authority_submission_status [not null, default: 'DRAFT']

  submission_reference varchar(150)

  submission_method varchar(100)

  submitted_by_account_id bigint [not null]
  is_required boolean [not null, default: true]

  permit_number varchar(150)
  permit_issued_date date
  permit_expiry_date date
  revision_due_date date

  submitted_at timestamp

  response_received_at timestamp

  decision_note text

  rejection_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    compliance_dossier_id
    status
    submission_reference

    (compliance_dossier_id, submission_no) [unique]
  }
}


Table AuthoritySubmissionEvidenceFile {
  Note: 'AuthoritySubmissionEvidenceFile: File minh chứng phản hồi của cơ quan chức năng, ví dụ văn bản chấp nhận, từ chối hoặc yêu cầu bổ sung cho một lần AuthoritySubmission.'

  authority_submission_evidence_file_id uuid [pk]

  authority_submission_id bigint [not null]

  evidence_type authority_evidence_type [not null]

  uploaded_by_employee_id bigint [not null]

  file_name varchar(255) [not null]
  file_url varchar(1000) [not null]
  mime_type varchar(100)
  file_size_bytes bigint

  note text

  created_at timestamp [not null]

  indexes {
    authority_submission_id
    evidence_type
    uploaded_by_employee_id
  }
}


//////////////////////////////////////////////////////////////
// PROOF / DOSSIER AUDIT
//////////////////////////////////////////////////////////////

Table QuarantineProof {
  Note: 'QuarantineProof: Bằng chứng và kết quả kiểm dịch tại trạm BCP do Driver hoặc Escort nộp và Transport Specialist xác minh. Cả kết quả đạt, có điều kiện, tạm giữ, thất bại hoặc bị từ chối đều lưu tại đây và không thay đổi ComplianceDossier.status. File vật lý được lưu tại ProofAttachment.'

  quarantine_proof_id bigint [pk, increment]

  compliance_dossier_id bigint [not null]

  status quarantine_proof_status [not null, default: 'PENDING_VERIFICATION']

  submitted_by_employee_id bigint [not null]
  verified_by_employee_id bigint
  location_id bigint

  bcp_name varchar(200) [not null]
  official_veterinarian_name varchar(200)
  bcp_receipt_number varchar(150)

  submitted_note text

  // Danh sách đối chiếu microchip theo từng Horse trong dossier.
  microchip_checklist jsonb

  inspection_at timestamp
  submitted_at timestamp [not null]
  verified_at timestamp

  conditions text
  verification_note text
  rejection_reason text

  is_finalized boolean [not null, default: false]
  finalized_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    compliance_dossier_id
    status
    submitted_by_employee_id
    verified_by_employee_id
    location_id
    bcp_receipt_number
    submitted_at
  }
}


Table CustomsClearanceProof {
  Note: 'CustomsClearanceProof: Bằng chứng và kết quả thông quan hải quan do Driver nộp và Transport Specialist xác minh. Cả kết quả thông quan, tạm giữ hoặc bị từ chối đều lưu tại đây và không thay đổi ComplianceDossier.status. File vật lý được lưu tại ProofAttachment.'

  customs_clearance_proof_id bigint [pk, increment]

  compliance_dossier_id bigint [not null]

  status customs_clearance_proof_status [not null, default: 'PENDING_VERIFICATION']
  customs_lane customs_lane

  submitted_by_employee_id bigint [not null]
  verified_by_employee_id bigint
  location_id bigint

  customs_port_name varchar(200) [not null]
  mrn_number varchar(150)

  submitted_note text
  ata_carnet_expiry_date date

  clearance_at timestamp
  submitted_at timestamp [not null]
  verified_at timestamp

  verification_note text
  rejection_reason text

  is_finalized boolean [not null, default: false]
  finalized_at timestamp

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    compliance_dossier_id
    status
    customs_lane
    submitted_by_employee_id
    verified_by_employee_id
    location_id
    mrn_number
    submitted_at
  }
}


Table ProofAttachment {
  Note: 'ProofAttachment: File vật lý thuộc QuarantineProof hoặc CustomsClearanceProof. Mỗi record phải thuộc đúng một loại Proof.'

  proof_attachment_id uuid [pk]

  quarantine_proof_id bigint
  customs_clearance_proof_id bigint

  file_name varchar(255) [not null]
  file_url varchar(1000) [not null]
  mime_type varchar(100)
  file_size_bytes bigint
  sort_order int [not null]
  created_at timestamp [not null]

  indexes {
    quarantine_proof_id
    customs_clearance_proof_id
    (quarantine_proof_id, sort_order) [unique]
    (customs_clearance_proof_id, sort_order) [unique]
  }
}


Table AuditDossier {
  Note: 'AuditDossier: Nhật ký append-only của ComplianceDossier. Bản ghi chỉ được thêm mới, không được sửa hoặc xóa qua API.'

  audit_dossier_id bigint [pk, increment]

  compliance_dossier_id bigint [not null]

  action_type varchar(100) [not null]
  target_entity varchar(100) [not null]
  target_id bigint

  actor_account_id bigint [not null]

  summary varchar(500)
  details jsonb

  visibility audit_visibility [not null, default: 'PUBLIC']

  created_at timestamp [not null]

  indexes {
    compliance_dossier_id
    action_type
    target_entity
    target_id
    actor_account_id
    visibility
    created_at
  }
}


//////////////////////////////////////////////////////////////
// CATALOG AUDIT
//////////////////////////////////////////////////////////////

Table CatalogAuditLog {
  Note: 'CatalogAuditLog: Append-only audit cho thay đổi các bảng catalog như ComplianceRequirement. Không thay thế AuditDossier của một ComplianceDossier cụ thể.'

  catalog_audit_log_id bigint [pk, increment]

  entity_type varchar(100) [not null]
  entity_id bigint [not null]
  action_type varchar(100) [not null]

  actor_account_id bigint [not null]

  summary varchar(500)
  before_data jsonb [not null]
  after_data jsonb [not null]
  reference_count_snapshot jsonb

  created_at timestamp [not null]

  indexes {
    (entity_type, entity_id)
    actor_account_id
    created_at
  }
}


//////////////////////////////////////////////////////////////
// FLOW 8 - NOTIFICATION
//////////////////////////////////////////////////////////////

Table Notification {
  notification_id bigint [pk, increment]

  transport_id bigint [not null]

  notification_type notification_type [not null]

  priority notification_priority [not null, default: 'NORMAL']

  title varchar(200) [not null]

  message text [not null]

  reference_type varchar(100)
  reference_id bigint

  action_url varchar(1000)

  created_at timestamp [not null]

  expires_at timestamp

  indexes {
    transport_id
    notification_type
    priority
    created_at

    (reference_type, reference_id)
  }
}


Table AccountNotification {
  account_id bigint [not null]

  notification_id bigint [not null]

  status recipient_status [not null, default: 'PENDING']

  delivered_at timestamp
  read_at timestamp

  created_at timestamp [not null]

  indexes {
    (account_id, notification_id) [pk]

    notification_id
    status
    read_at
  }
}


//////////////////////////////////////////////////////////////
// FLOW 9 - TRANSACTIONAL OUTBOX
//////////////////////////////////////////////////////////////

Table OutboxMessage {
  Note: 'OutboxMessage: Sự kiện cần xử lý sau khi transaction nghiệp vụ commit. Worker gửi email hoặc SignalR, retry khi lỗi và giữ DEAD để theo dõi.'

  outbox_message_id uuid [pk]
  message_type varchar(100) [not null]
  payload text [not null]
  status varchar(20) [not null, default: 'PENDING']
  attempts int [not null, default: 0]
  available_at timestamp [not null]
  locked_at timestamp
  processed_at timestamp
  last_error text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (status, available_at)
    created_at
  }
}


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - SOFT DELETE
//////////////////////////////////////////////////////////////

Ref: Account.deleted_by_account_id > Account.account_id
Ref: Customer.deleted_by_account_id > Account.account_id
Ref: Employee.deleted_by_account_id > Account.account_id
Ref: Horse.deleted_by_account_id > Account.account_id
Ref: Location.deleted_by_account_id > Account.account_id
Ref: Route.deleted_by_account_id > Account.account_id
Ref: Vehicle.deleted_by_account_id > Account.account_id
Ref: TransportProvider.deleted_by_account_id > Account.account_id
Ref: ComplianceRequirement.deleted_by_account_id > Account.account_id
Ref: DossierTemplate.deleted_by_account_id > Account.account_id
Ref: DossierRequirement.deleted_by_account_id > Account.account_id


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - CORE
//////////////////////////////////////////////////////////////

Ref: Customer.account_id - Account.account_id
Ref: Employee.account_id - Account.account_id

// Account 1 - N RefreshToken
Ref: RefreshToken.account_id > Account.account_id

// Optional self-reference used by refresh-token rotation
Ref: RefreshToken.replaced_by_token_id > RefreshToken.refresh_token_id

Ref: Horse.customer_id > Customer.customer_id

Ref: Booking.customer_id > Customer.customer_id
Ref: Booking.assigned_employee_id > Employee.employee_id

Ref: BookingHorse.booking_id > Booking.booking_id
Ref: BookingHorse.horse_id > Horse.horse_id

Ref: BookingStatusHistory.booking_id > Booking.booking_id
Ref: BookingStatusHistory.changed_by_account_id > Account.account_id

Ref: Transport.booking_id - Booking.booking_id


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - TRANSPORT PLANNING
//////////////////////////////////////////////////////////////

Ref: TransportPlan.transport_id > Transport.transport_id
Ref: TransportPlan.approved_by_employee_id > Employee.employee_id

Ref: RoutePlan.transport_plan_id > TransportPlan.transport_plan_id

Ref: Route.from_location_id > Location.location_id
Ref: Route.to_location_id > Location.location_id

Ref: RoutePlanRoute.route_plan_id > RoutePlan.route_plan_id
Ref: RoutePlanRoute.route_id > Route.route_id
Ref: RoutePlanRoute.driver_employee_id > Employee.employee_id
Ref: RoutePlanRoute.escort_employee_id > Employee.employee_id
Ref: RoutePlanRoute.transport_provider_id > TransportProvider.transport_provider_id

// RoutePlanRoute N - N Vehicle
Ref: RoutePlanRouteVehicle.route_plan_route_id > RoutePlanRoute.route_plan_route_id
Ref: RoutePlanRouteVehicle.vehicle_id > Vehicle.vehicle_id

Ref: TransportPlanProvider.transport_plan_id > TransportPlan.transport_plan_id
Ref: TransportPlanProvider.transport_provider_id > TransportProvider.transport_provider_id

Ref: EmployeeTransportPlan.employee_id > Employee.employee_id
Ref: EmployeeTransportPlan.transport_plan_id > TransportPlan.transport_plan_id


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - EXECUTION
//////////////////////////////////////////////////////////////

Ref: HandoverRecord.transport_id > Transport.transport_id

Ref: HandoverRecord.from_customer_id > Customer.customer_id
Ref: HandoverRecord.from_employee_id > Employee.employee_id
Ref: HandoverRecord.to_customer_id > Customer.customer_id
Ref: HandoverRecord.to_employee_id > Employee.employee_id

Ref: HandoverRecord.from_route_plan_route_id > RoutePlanRoute.route_plan_route_id
Ref: HandoverRecord.to_route_plan_route_id > RoutePlanRoute.route_plan_route_id

Ref: HorseHealthLog.transport_id > Transport.transport_id
Ref: HorseHealthLog.horse_id > Horse.horse_id
Ref: HorseHealthLog.employee_id > Employee.employee_id


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - INCIDENT / EMERGENCY
//////////////////////////////////////////////////////////////

Ref: IncidentReport.employee_id > Employee.employee_id
Ref: IncidentReport.location_id > Location.location_id

Ref: VehicleIncidentDetail.incident_report_id - IncidentReport.incident_report_id
Ref: VehicleIncidentDetail.vehicle_id > Vehicle.vehicle_id

Ref: HorseHealthIncidentDetail.incident_report_id > IncidentReport.incident_report_id
Ref: HorseHealthIncidentDetail.horse_id > Horse.horse_id

Ref: EmergencyCostRequest.incident_report_id > IncidentReport.incident_report_id

Ref: CostApprovalDecision.emergency_cost_request_id - EmergencyCostRequest.emergency_cost_request_id
Ref: CostApprovalDecision.employee_id > Employee.employee_id


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - FINANCE
//////////////////////////////////////////////////////////////

Ref: Invoice.booking_id > Booking.booking_id
Ref: Invoice.employee_id > Employee.employee_id

Ref: InvoiceItem.invoice_id > Invoice.invoice_id
Ref: InvoiceItem.horse_id > Horse.horse_id

// Business rule confirmed:
// EmergencyCostRequest 1 -> 1 InvoiceItem once billed.
// Physical lifecycle allows 0..1 before billing.
Ref: InvoiceItem.emergency_cost_request_id - EmergencyCostRequest.emergency_cost_request_id

Ref: Receipt.invoice_id > Invoice.invoice_id

Ref: InvoiceStatusHistory.invoice_id > Invoice.invoice_id
Ref: InvoiceStatusHistory.changed_by_account_id > Account.account_id

Ref: FinancialReport.transport_id - Transport.transport_id


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - CLAIM
//////////////////////////////////////////////////////////////

Ref: Claim.customer_id > Customer.customer_id
Ref: Claim.handover_record_id > HandoverRecord.handover_record_id

Ref: ClaimResolution.claim_id - Claim.claim_id


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - COMPLIANCE
//////////////////////////////////////////////////////////////

Ref: DossierTemplateItem.compliance_requirement_id > ComplianceRequirement.compliance_requirement_id
Ref: DossierTemplateItem.dossier_template_id > DossierTemplate.dossier_template_id

Ref: ComplianceDossier.transport_id - Transport.transport_id

Ref: DossierRequirement.compliance_dossier_id > ComplianceDossier.compliance_dossier_id
Ref: DossierRequirement.compliance_requirement_id > ComplianceRequirement.compliance_requirement_id
Ref: DossierRequirement.horse_id > Horse.horse_id

Ref: DocumentRequest.dossier_requirement_id > DossierRequirement.dossier_requirement_id
Ref: DocumentRequest.document_review_id - DocumentReview.document_review_id

Ref: ComplianceDocument.dossier_requirement_id - DossierRequirement.dossier_requirement_id

Ref: DocumentVersion.compliance_document_id > ComplianceDocument.compliance_document_id
Ref: ComplianceDocument.created_by_account_id > Account.account_id
Ref: ComplianceDocument.updated_by_account_id > Account.account_id
Ref: DocumentVersion.uploaded_by_account_id > Account.account_id

Ref: DocumentAttachment.document_version_id > DocumentVersion.document_version_id

Ref: DocumentReview.document_version_id > DocumentVersion.document_version_id
Ref: DocumentReview.reviewed_by_account_id > Account.account_id

Ref: DocumentRequest.requested_by_account_id > Account.account_id
Ref: DocumentRequestComment.document_request_id > DocumentRequest.document_request_id
Ref: DocumentRequestComment.author_account_id > Account.account_id
Ref: MissingDocumentReminder.compliance_dossier_id > ComplianceDossier.compliance_dossier_id
Ref: MissingDocumentReminder.recipient_account_id > Account.account_id

Ref: AuthoritySubmission.compliance_dossier_id > ComplianceDossier.compliance_dossier_id
Ref: AuthoritySubmission.submitted_by_account_id > Account.account_id
Ref: AuthoritySubmissionEvidenceFile.authority_submission_id > AuthoritySubmission.authority_submission_id
Ref: AuthoritySubmissionEvidenceFile.uploaded_by_employee_id > Employee.employee_id

//////////////////////////////////////////////////////////////
// RELATIONSHIPS - PROOF / DOSSIER AUDIT
//////////////////////////////////////////////////////////////

Ref: QuarantineProof.compliance_dossier_id > ComplianceDossier.compliance_dossier_id
Ref: QuarantineProof.submitted_by_employee_id > Employee.employee_id
Ref: QuarantineProof.verified_by_employee_id > Employee.employee_id
Ref: QuarantineProof.location_id > Location.location_id

Ref: CustomsClearanceProof.compliance_dossier_id > ComplianceDossier.compliance_dossier_id
Ref: CustomsClearanceProof.submitted_by_employee_id > Employee.employee_id
Ref: CustomsClearanceProof.verified_by_employee_id > Employee.employee_id
Ref: CustomsClearanceProof.location_id > Location.location_id

Ref: ProofAttachment.quarantine_proof_id > QuarantineProof.quarantine_proof_id
Ref: ProofAttachment.customs_clearance_proof_id > CustomsClearanceProof.customs_clearance_proof_id

Ref: AuditDossier.compliance_dossier_id > ComplianceDossier.compliance_dossier_id
Ref: AuditDossier.actor_account_id > Account.account_id
Ref: CatalogAuditLog.actor_account_id > Account.account_id


//////////////////////////////////////////////////////////////
// RELATIONSHIPS - NOTIFICATION
//////////////////////////////////////////////////////////////

Ref: Notification.transport_id > Transport.transport_id

Ref: AccountNotification.account_id > Account.account_id
Ref: AccountNotification.notification_id > Notification.notification_id


//////////////////////////////////////////////////////////////
// FINAL DESIGN NOTES
//
// 1) Location is master map data and is reusable.
//    Route owns from_location_id / to_location_id.
//    RoutePlan uses Route through RoutePlanRoute.
//
// 2) PENDING is the unified waiting/processing state where applicable.
//
// 3) Incident category rule:
//    VEHICLE      -> VehicleIncidentDetail expected.
//    HORSE_HEALTH -> one or more HorseHealthIncidentDetail expected.
//    BOTH         -> both detail types expected.
//    This consistency is enforced by application/business logic.
//
// 4) Vehicle is reusable master data for ROAD / AIR / SEA.
//    Vehicle is assigned N-N to RoutePlanRoute through RoutePlanRouteVehicle.
//    Business rule: Vehicle.transport_mode must match the Route.transport_mode
//    used by that RoutePlanRoute.
//
// 5) RefreshToken belongs to Account (Account 1-N RefreshToken).
//    Store token_hash only; raw refresh tokens must not be persisted in DB.
//    replaced_by_token_id supports refresh-token rotation.
//
// 6) DossierRequirement may be dossier-level (horse_id NULL) or
//    horse-specific (horse_id NOT NULL). Per-horse applicability is
//    enforced by business logic.
//
// 7) Reviewer/requester/submission actor FKs are not added where the
//    confirmed source model did not define those relationships.
//
// 8) Notification.reference_type + reference_id is polymorphic;
//    application logic must validate the referenced target.
//
// 9) Monetary summary fields must be calculated by backend/service logic.
//    Do not trust client-provided totals.
//
// 10) Horse.weight_kg and Horse.height_cm represent CURRENT measurements.
//     Historical measurement tracking is intentionally not added in V4.
//
// 11) Each RoutePlanRoute has one assigned Driver logically.
//     driver_employee_id may be NULL while planning is DRAFT, but must be
//     populated before RoutePlan becomes CONFIRMED / ACTIVE.
//     The referenced Employee must have role = DRIVER.
//
// 12) Handover party rules:
//     from_type = CUSTOMER -> from_customer_id NOT NULL and from_employee_id NULL.
//     from_type = EMPLOYEE -> from_employee_id NOT NULL and from_customer_id NULL.
//     Same XOR rule applies to to_type / to_* IDs.
//
// 13) Handover route rules:
//     - Pickup: from_route_plan_route_id NULL, to_route_plan_route_id = first leg.
//     - Internal handover: both route-plan-route IDs present.
//     - Delivery: from_route_plan_route_id = final leg, to_route_plan_route_id NULL.
//     If both are present, they must belong to the same RoutePlan and:
//         to.sequence_no = from.sequence_no + 1
//
// 14) For EMPLOYEE -> EMPLOYEE internal handover:
//     HandoverRecord.from_employee_id must equal the Driver assigned to the
//     from RoutePlanRoute, and to_employee_id must equal the Driver assigned
//     to the to RoutePlanRoute.
//
// 15) BookingStatusHistory and InvoiceStatusHistory are the business audit/history
//     tables for status transitions. Their type fields identify the action.
//     V4 does NOT add a centralized AuditLog table.
//
// 16) V5 soft-delete scope:
//     Account, Customer, Employee, Horse, Location, Route, Vehicle,
//     TransportProvider, ComplianceRequirement, DossierTemplate.
//
// 17) Soft-delete fields:
//     is_deleted = logical deletion flag.
//     deleted_at = deletion timestamp.
//     deleted_by_account_id = Account that performed the deletion.
//
// 18) Transaction/history tables keep status/history instead of soft delete.
//
// 20) Document attachment rule:
//     DossierRequirement 1--1 ComplianceDocument
//     ComplianceDocument 1--N DocumentVersion
//     DocumentVersion 1--N DocumentAttachment
//     DocumentVersion 1--N DocumentReview
//     DocumentAttachment has no direct FK to ComplianceDocument or DossierRequirement.
//
// 21) ComplianceRequirement includes country, category and an optional
//     validity_period_days. When a requirement is applied, the service
//     calculates DossierRequirement.valid_until.
//
// 22) AuthoritySubmissionEvidenceFile stores one or more authority response
//     files, such as acceptance, rejection or additional-information documents,
//     for a specific AuthoritySubmission.
//
// 23) QuarantineProof and CustomsClearanceProof are separate domain entities.
//     Their physical files are stored in ProofAttachment. Each ProofAttachment
//     must reference exactly one of the two Proof tables; this XOR rule is
//     enforced by migration/database constraint and application validation.

// 24) DocumentRequest may be created from one DocumentReview at most once.
//     DocumentRequestComment stores the conversation between the customer and
//     Transport Specialist for a request.

// 25) MissingDocumentReminder is a durable email reminder queue. Its worker
//     retries delivery and updates last_attempt_at, email_sent_at,
//     cancelled_at and email_attempts.

// 26) OutboxMessage is written in the same transaction as business changes.
//     EMAIL and SIGNALR_ACCOUNT messages are processed after commit by the
//     TransactionalOutboxWorker. Failed messages retry and eventually become
//     DEAD; payload contains the integration-specific JSON data.

// 19) PostgreSQL note: if unique values should be reusable after soft deletion,
//     implement partial unique indexes with WHERE is_deleted = false where needed.
//////////////////////////////////////////////////////////////
