//////////////////////////////////////////////////////////////
// RACEHORSE CROSS-BORDER TRANSPORT SYSTEM
// PHYSICAL ERD - CONSOLIDATED FINAL V8
//
// Basis:
// - Original SWP.drawio.xml logical/conceptual ERD
// - Confirmed relationship and status decisions from the design discussion
//
// V8 decision: EmployeeTransportPlan is the canonical assignment table; booking-level assignment table removed.
// Main V2 decisions:
// - Location is reusable map master data.
// - Route is a reusable directed segment from one Location to another.
// - RoutePlan is an ordered collection of Route records via RoutePlanRoute.
// - DRIVER and ESCORT are separate Employee roles.
// - PENDING is the unified waiting/processing status where applicable.
// - Incident category is simplified to VEHICLE / HORSE_HEALTH / BOTH.
// - Claim is intentionally simple; discussion/negotiation happens outside the system.
// - FinancialReport has no draft/final status; it is a generated summary.
// - Legal/compliance tables contain explicit Vietnamese notes to avoid terminology confusion.
// - V3: Vehicle is reusable transport master data (road/air/sea) and is assigned N-N to RoutePlanRoute.
// - V3: RefreshToken is added for JWT refresh-token/session lifecycle per Account.
// - V4: Horse adds current weight/height.
// - V4: One DRIVER is assigned to each RoutePlanRoute (nullable while drafting).
// - V4: HandoverRecord identifies CUSTOMER/EMPLOYEE on both sides and the from/to RoutePlanRoute.
// - V4: BookingStatusHistory and InvoiceStatusHistory add explicit action type; no centralized AuditLog is added.
// - V5: Soft delete is added only to selected master/profile/config tables.
// - V6: DocumentAttachment stores one or more physical files belonging to one DocumentVersion.
// - V6.2: ComplianceDossier is the pre-departure dossier prepared and owned by the Transport Specialist.
// - V6.2: Border quarantine/customs outcomes, including failed/rejected outcomes, are stored only in
//   QuarantineProof and CustomsClearanceProof; they never overwrite ComplianceDossier.status.
//////////////////////////////////////////////////////////////


//////////////////////////////////////////////////////////////
// ENUMS - CORE
//////////////////////////////////////////////////////////////

Enum account_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

Enum account_type {
  CUSTOMER
  EMPLOYEE
}

Enum employee_role {
  LOGISTICS_MANAGER
  TRANSPORT_SPECIALIST
  FLEET_ROUTE_COORDINATOR
  DRIVER
  ESCORT
}

Enum horse_sex {
  MALE
  FEMALE
  GELDING
}

Enum booking_status {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

Enum booking_history_type {
  SUBMIT
  APPROVE
  REJECT
  CANCEL
}

Enum transport_status {
  CREATED
  PLANNING
  READY
  IN_TRANSIT
  COMPLETED
  CANCELLED
}


//////////////////////////////////////////////////////////////
// ENUMS - TRANSPORT PLANNING
//////////////////////////////////////////////////////////////

