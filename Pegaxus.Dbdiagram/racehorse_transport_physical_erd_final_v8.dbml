Enum handover_status {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

Enum handover_party_type {
  CUSTOMER
  EMPLOYEE
} 

Enum horse_health_log_type {
  PRE_TRIP_CHECK
  ROUTINE_CHECK
  BORDER_CHECK
  REST_STOP_CHECK
  INCIDENT_FOLLOWUP
  POST_TRIP_CHECK
  OTHER
