  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

Enum route_plan_status {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

Enum transport_mode {
  ROAD
  SEA
  AIR
}

Enum route_type {
  PRIMARY
  BACKUP
  RETURN
}

Enum location_type {
  CITY
  BORDER_GATE
  AIRPORT
  SEAPORT
  STABLE
  REST_STOP
  OTHER
}

Enum vehicle_status {
  AVAILABLE
  ASSIGNED
  IN_USE
  MAINTENANCE
  INACTIVE
}

Enum provider_status {
  ACTIVE
  INACTIVE
  SUSPENDED
}


