# ==============================================================================
# Pegaxus Backend - Environment Configuration Template
# Sao chép file này thành .env và chỉnh sửa các giá trị bảo mật trước khi chạy
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=pegaxus_user
POSTGRES_PASSWORD=pegaxus_secret_password
POSTGRES_DB=pegaxus_db
POSTGRES_PORT=5432

# Required for local dotnet / dotnet ef; Docker Compose supplies its own connection string.
ConnectionStrings__DefaultConnection=

# Redis OTP cache
REDIS_PORT=6379

# Application Settings
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# Required for ROAD route distance and duration calculations.
Geoapify__ApiKey=

# Transactional email through the Brevo API (https://developer.brevo.com/reference/sendtransacemail).
# SenderEmail must be a sender or domain verified in the Brevo dashboard.
Brevo__ApiUrl=https://api.brevo.com/v3/smtp/email
Brevo__ApiKey=
Brevo__SenderName=Pegaxus
Brevo__SenderEmail=

# JWT Authentication
JWT_SECRET=your_secret
JWT_ISSUER=pegaxusServer
JWT_AUDIENCE=pegaxusClient
JWT_EXPIRY_MINUTES=1440

# CORS Configuration (phân tách bởi dấu chấm phẩy ;)
ALLOWED_ORIGINS=http://localhost:3000;http://localhost:5173

# Direct document uploads (authenticated Cloudinary assets)
CloudinaryOptions__CloudName=
CloudinaryOptions__ApiKey=
CloudinaryOptions__ApiSecret=

# Legacy private S3 documents
DocumentStorageOptions__BucketName=
DocumentStorageOptions__Region=us-east-1

# Front-end origin: allowed by CORS and used for the buttons in emails and the Google sign-in redirect. HTTPS only (http is accepted for localhost).
Cors__FrontendUrl=

# SePay checkout (Sandbox and Production use different credentials)
SePayOptions__MerchantId=
SePayOptions__SecretKey=
SePayOptions__Environment=sandbox
# Return URL after checkout (success, error and cancel). {invoiceId} is required; {bookingId} is optional.
# Customers open an invoice at /bookings/{bookingId}/invoices/{invoiceId}. Production must use HTTPS.
SePayOptions__InvoiceDetailsUrlTemplate=http://localhost:3000/bookings/{bookingId}/invoices/{invoiceId}

# SePay gateway IPN: set auth type SECRET_KEY and the same secret in the merchant dashboard.
# IPN URL: https://<api-host>/api/v1/payments/webhook
# https://developer.sepay.vn/vi/cong-thanh-toan/IPN
# Supported IPNs: ORDER_PAID and TRANSACTION_VOID. SePay does not document FAILED/EXPIRED IPNs.
SePayWebhookOptions__SecretKey=
