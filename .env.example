# ==============================================================================
# Pegaxus Backend - Environment Configuration Template
# Sao chép file này thành .env và chỉnh sửa các giá trị bảo mật trước khi chạy
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=pegaxus_user
POSTGRES_PASSWORD=pegaxus_secret_password
POSTGRES_DB=pegaxus_db
POSTGRES_PORT=5432

# Redis OTP cache
REDIS_PORT=6379

# Application Settings
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# Transactional email (Gmail SMTP)
MailOptions__Mail=hkbdu.admin@gmail.com
MailOptions__DisplayName=Gegaxus
MailOptions__Password=
MailOptions__Host=smtp.gmail.com
MailOptions__Port=587

# JWT Authentication
JWT_SECRET=YourSuperSecretKeyWithAtLeast32CharactersLongForPegaxus2026!
JWT_ISSUER=Pegaxus.API
JWT_AUDIENCE=Pegaxus.Client
JWT_EXPIRY_MINUTES=1440

# CORS Configuration (phân tách bởi dấu chấm phẩy ;)
ALLOWED_ORIGINS=http://localhost:3000;http://localhost:5173
